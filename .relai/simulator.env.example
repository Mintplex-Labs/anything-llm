# The simulator uses an in-process deterministic provider and requires no environment variables.
# Production AnythingLLM provider and storage settings are configured separately.

# Live document-grounding environments use the local AnythingLLM Developer API.
# Copy these names to the ignored .relai/simulator.env and provide local values.
# ANYTHINGLLM_API_BASE=http://127.0.0.1:3101/api
# ANYTHINGLLM_API_KEY=
# ANYTHINGLLM_WORKSPACE_SLUG=relai-agent-eval
