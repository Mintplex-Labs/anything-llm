# =====================================================================
# knowledge-base-llm: configuration template (OpenRouter as the LLM)
# =====================================================================
# Easiest: let the setup script fill this in for you.
#   deploy/setup-env.sh docker   -> writes docker/.env (docker compose)
#   deploy/setup-env.sh local    -> writes server/.env + collector/.env
#   deploy/setup-env.sh dev      -> writes server/.env.development + frontend/.env
#
# By hand: copy this file to the target above and fill in every value
# marked REQUIRED.
#
# Things to know before editing:
# - Once someone saves settings in the UI, the server rewrites the .env file
#   with only the keys it recognizes. Comments disappear, and every value is
#   cut off at the first  #  '  "  `  or tab. Keep secrets and keys to
#   letters, digits, "-" and "_".
# - Changing EMBEDDING_ENGINE or EMBEDDING_MODEL_PREF after documents have
#   been embedded means every document has to be embedded again.
# - Full variable reference: docs/configuration.md

###########################################
# Server basics
###########################################
SERVER_PORT=3001

# Where the database, documents, vectors and caches live.
# Docker: keep /app/server/storage (mounted from ../server/storage).
# Bare metal: absolute path to this repo's server/storage folder.
STORAGE_DIR="/app/server/storage"

# Docker build only: the host user/group that owns the mounted folders.
# The server drops these two lines the first time it rewrites this file,
# which only matters if your host user is not 1000.
UID="1000"
GID="1000"

###########################################
# Secrets (REQUIRED)
###########################################
# Generate each one with:  openssl rand -hex 32

# Signs login sessions. Changing it logs everyone out.
JWT_SECRET=""
# Encryption key and salt (32+ characters each). They protect the
# single-user session, the Telegram bot token and saved data-connector
# credentials. Changing them later logs single-user sessions out and makes
# those saved values unreadable. Documents and vectors are not affected.
SIG_KEY=""
SIG_SALT=""
# Optional session lifetime, e.g. 30d or 12h.
# JWT_EXPIRY="30d"

# Password for single-user mode. Single-user mode only asks for a login
# when BOTH AUTH_TOKEN and JWT_SECRET are set; otherwise anyone who can
# reach the server has full admin access. Keep it set until you turn on
# multi-user mode (Settings > Security), which cannot be turned off again.
AUTH_TOKEN=""

###########################################
# LLM: OpenRouter (REQUIRED)
###########################################
LLM_PROVIDER="openrouter"
OPENROUTER_API_KEY=""

# Any model id from https://openrouter.ai/models
# "openrouter/auto" lets OpenRouter pick per request. A fixed model gives
# predictable cost and behavior. Agent features need a model that supports
# tool calling.
OPENROUTER_MODEL_PREF="openrouter/auto"

# Longest pause (ms) allowed between streamed chunks before the answer is
# treated as finished. Raise this if long answers get cut off mid-sentence.
# Default 3000, minimum 500. Do not leave it set but empty: an empty value
# is read as 500.
# OPENROUTER_TIMEOUT_MS=3000

# auto | default | fast | flex | priority | scale
# Some providers reject tiers they do not support.
# OPENROUTER_SERVICE_TIER="default"

###########################################
# Embeddings (pick one, before uploading documents)
###########################################
# EMBEDDING_MODEL_PREF is shared by every engine, so change both lines
# together when switching.

# Option A: OpenRouter embeddings. Same key as above, billed per token.
# With this engine the default chunk size is 8,191 characters, far larger
# than usual for retrieval. Set a chunk size (Settings > AI Providers >
# Text Splitter & Chunking) before uploading documents.
EMBEDDING_ENGINE="openrouter"
EMBEDDING_MODEL_PREF="baai/bge-m3"

# Option B: built-in local embedder. Free and private, runs on the CPU,
# downloads a 23 MB model on first use (Hugging Face, falling back to a
# Mintplex CDN mirror). Lower retrieval quality than modern hosted models.
# EMBEDDING_ENGINE="native"
# EMBEDDING_MODEL_PREF="Xenova/all-MiniLM-L6-v2"

###########################################
# Vector database
###########################################
# LanceDB is embedded and file-based (STORAGE_DIR/lancedb). No keys needed.
# For other options (pgvector, Qdrant, Pinecone, ...) see docs/configuration.md
VECTOR_DB="lancedb"

###########################################
# Speech and transcription (local defaults, no keys)
###########################################
WHISPER_PROVIDER="local"
TTS_PROVIDER="native"
STT_PROVIDER="native"

###########################################
# Image generation for the /img command (optional)
###########################################
# Uses its own key so it can differ from the chat key. No default model.
# IMAGE_GEN_PROVIDER="openrouter"
# IMAGE_GEN_OPENROUTER_API_KEY=""
# IMAGE_GEN_MODEL_PREF=""

###########################################
# Privacy and hardening
###########################################
# Stop anonymous usage events to Mintplex Labs' PostHog.
DISABLE_TELEMETRY="true"
# Hide the public Swagger page at /api/docs (the API itself still works).
DISABLE_SWAGGER_DOCS="true"
# Public chat-widget embeds without an allowed-domains list refuse requests.
EMBED_REQUIRE_ALLOWLIST="true"

###########################################
# Agent web search (optional, pick one and add your own key)
###########################################
# AGENT_TAVILY_API_KEY=""
# AGENT_SERPER_DEV_KEY=""
# AGENT_SEARXNG_API_URL=""
# More providers: docs/configuration.md
